{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app's windows may do. Everything that touches the OS goes through the app's own commands.",
  "windows": [
    "island",
    "settings"
  ],
  "permissions": [
    "core:default",
    "autostart:default",
    "notification:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered"
  ]
}
